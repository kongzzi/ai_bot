# ── App ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=dev

# ── Audio / Protocol ───────────────────────────────
MAX_AUDIO_SECONDS=30
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60

# ── 개발용 장치 토큰 ("device_id:token" 쉼표 구분) ──
# 운영에서는 해시 저장 + Key Vault로 전환 (기획서 18.3)
DEVICE_TOKENS=device-001:dev-token-001

# ── STT 공급자: mock | whisper ──────────────────────
# whisper 사용 시: pip install -e ".[whisper]" 후 아래 주석 해제
#STT_PROVIDER=whisper
#WHISPER_MODEL=small          # tiny/base/small/medium (클수록 정확·느림)
#WHISPER_LANGUAGE=ko
#WHISPER_COMPUTE_TYPE=int8

# ── Phase 4에서 사용 (지금은 Mock이라 불필요) ───────
